# PostgreSQL is mandatory in production. Omit DATABASE_URL only for local development storage.
DATABASE_URL=postgresql://user:password@localhost:5432/ustazai
AUTH_SECRET=replace-with-at-least-32-random-characters
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
OCR_PROVIDER=mock
OCR_API_KEY=
OCR_MODEL=gpt-4.1-mini
MAX_UPLOAD_SIZE=10485760
STORAGE_PATH=./uploads/private
CONFIDENCE_THRESHOLD=70
NEXT_PUBLIC_DEMO_MODE=true
